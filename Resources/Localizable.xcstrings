          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート元が未設定"
          }
        }
      }
    },
    "Used to capture window thumbnails and to enumerate windows on other desktops. The switcher still works without it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to capture window thumbnails and to enumerate windows on other desktops. The switcher still works without it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于抓取窗口缩略图并枚举其他桌面的窗口。未授权时切换器仍可正常使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於擷取視窗縮覽圖並列舉其他桌面的視窗。未授權時切換器仍可正常使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウのサムネール取得と、ほかのデスクトップのウインドウ列挙に使います。許可がなくても切り替えは使えます。"
          }
        }
      }
    },
    "Used to intercept hotkeys and to enumerate and focus windows. Restart Napoleon after granting it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to intercept hotkeys and to enumerate and focus windows. Restart Napoleon after granting it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于拦截快捷键、枚举并聚焦窗口。授权后需重新启动 Napoleon。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於攔截快捷鍵、列舉並聚焦視窗。授權後需重新啟動 Napoleon。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットの取得と、ウインドウの列挙・フォーカスに使います。許可後は Napoleon を再起動してください。"
          }
        }
      }
    },
