    "Uses cached thumbnails only. No new screenshot will be taken.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses cached thumbnails only. No new screenshot will be taken."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅使用缓存缩略图，不会重新截图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅使用快取縮圖，不會重新截圖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュ済みサムネイルのみを使用し、新しいスクリーンショットは撮りません。"
          }
        }
      }
    },
    "A larger cache keeps more thumbnails ready when you switch back and forth, at the cost of memory.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A larger cache keeps more thumbnails ready when you switch back and forth, at the cost of memory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上限越大，来回切换时越多缩略图可即时显示，但内存占用也越高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上限越大，來回切換時越多縮覽圖可即時顯示，但記憶體用量也越高。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限を大きくするほど、切り替え時にすぐ表示できるサムネールが増えますが、メモリ使用量も増えます。"
          }
        }
      }
    },
