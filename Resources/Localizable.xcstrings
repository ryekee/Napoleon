    "How long to hold the hotkey before the overlay appears. Release sooner and Napoleon switches straight to the previous window, with no overlay.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long to hold the hotkey before the overlay appears. Release sooner and Napoleon switches straight to the previous window, with no overlay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住快捷键多久后才显示浮层。在此之前松开则直接切到上一个窗口，不显示浮层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住快捷鍵多久後才顯示浮層。在此之前放開則直接切到上一個視窗，不顯示浮層。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーバーレイが表示されるまでショートカットを押し続ける時間です。それより早く離すと、オーバーレイなしで直前のウインドウに切り替わります。"
          }
        }
      }
    },
    "Include minimized windows": {
      "extractionState": "manual",
