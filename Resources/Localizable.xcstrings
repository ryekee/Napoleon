    "When off, cards show only the app name and become more compact.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, cards show only the app name and become more compact."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后卡片只显示应用名称，更紧凑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後卡片只顯示 App 名稱，更緊湊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにするとカードは App 名のみになり、よりコンパクトになります。"
          }
        }
      }
    },
    "When off, only windows on the current desktop and full-screen apps are listed. Desktop windows always appear while you are in a full-screen space, so you can switch back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, only windows on the current desktop and full-screen apps are listed. Desktop windows always appear while you are in a full-screen space, so you can switch back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时只显示当前桌面和全屏 App 的窗口。处于全屏空间时始终会列出桌面窗口，便于切回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時只顯示目前桌面和全螢幕 App 的視窗。處於全螢幕空間時一律會列出桌面視窗，方便切回。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフのときは現在のデスクトップとフルスクリーン App のウインドウのみを表示します。フルスクリーン中はデスクトップのウインドウが常に表示され、戻れます。"
          }
        }
      }
    },
    "When off, the overlay is always dark.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, the overlay is always dark."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时浮层始终为深色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時浮層一律為深色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフのときオーバーレイは常にダークになります。"
          }
        }
      }
    },
