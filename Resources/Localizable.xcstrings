    "Find Chinese window titles by typing Pinyin — “gouwu” matches “购物清单”.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find Chinese window titles by typing Pinyin — “gouwu” matches “购物清单”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入拼音即可搜索中文窗口标题——「gouwu」匹配「购物清单」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入拼音即可搜尋中文視窗標題——「gouwu」比對「购物清单」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピンインを入力して中国語のウインドウタイトルを検索します（「gouwu」で「购物清单」に一致）。"
          }
        }
      }
    },
