    "Includes app names, Bundle IDs, window counts and IDs, permission states, hotkey events, durations, and error codes. Excludes window titles, searches, file paths, and images.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes app names, Bundle IDs, window counts and IDs, permission states, hotkey events, durations, and error codes. Excludes window titles, searches, file paths, and images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含应用名称、Bundle ID、窗口数量和 ID、权限状态、快捷键事件、耗时与错误码。不包含窗口标题、搜索内容、文件路径或图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含應用程式名稱、Bundle ID、視窗數量和 ID、權限狀態、快速鍵事件、耗時與錯誤碼。不包含視窗標題、搜尋內容、檔案路徑或圖片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ名、Bundle ID、ウインドウ数と ID、権限状態、ホットキーイベント、所要時間、エラーコードを含みます。ウインドウタイトル、検索内容、ファイルパス、画像は含みません。"
          }
        }
      }
    },
    "Issue to diagnose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Issue to diagnose"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要诊断的问题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要診斷的問題"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断する問題"
          }
        }
      }
    },
    "Napoleon does not upload logs directly. Your email client may sync the draft and attachment. Review the email before sending.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Napoleon does not upload logs directly. Your email client may sync the draft and attachment. Review the email before sending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Napoleon 不会直接上传日志。您的邮件客户端可能会同步邮件草稿和附件，请在发送前检查邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Napoleon 不會直接上傳日誌。您的郵件用戶端可能會同步郵件草稿與附件，請在傳送前檢查郵件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Napoleon がログを直接アップロードすることはありません。メールクライアントが下書きと添付ファイルを同期する場合があります。送信前にメールを確認してください。"
          }
        }
      }
    },
