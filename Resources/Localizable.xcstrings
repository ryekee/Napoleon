    "Applies to the all-windows switcher. The current-app shortcut always lists individual windows.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to the all-windows switcher. The current-app shortcut always lists individual windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于“所有窗口”切换器；“当前应用窗口”快捷键始终逐窗口显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅套用於「所有視窗」切換器；「目前 App 視窗」快捷鍵一律逐視窗顯示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「すべてのウインドウ」の切り替えにのみ適用されます。「現在の App」のショートカットは常にウインドウ単位で表示します。"
          }
        }
      }
    },
    "Find localized app and window names by typing Pinyin — “f” matches “访达”.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find localized app and window names by typing Pinyin — “f” matches “访达”."
