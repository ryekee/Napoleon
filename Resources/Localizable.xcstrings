    "macOS 15 and later re-asks for Screen Recording access periodically. If thumbnails disappear one day, check here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 15 and later re-asks for Screen Recording access periodically. If thumbnails disappear one day, check here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 15 起系统会定期重新征询屏幕录制授权。若某天缩略图消失，来这里检查即可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 15 起系統會定期重新詢問螢幕錄製授權。若某天縮覽圖消失，來這裡檢查即可。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 15 以降では画面収録の許可が定期的に再確認されます。サムネールが表示されなくなったら、ここで確認してください。"
          }
        }
      }
    },
