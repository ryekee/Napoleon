{
  "sourceLanguage": "en",
  "strings": {
    "Adds cached window thumbnails. Excludes search text, window titles, file paths, and new screenshots.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds cached window thumbnails. Excludes search text, window titles, file paths, and new screenshots."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增加缓存的窗口缩略图，不包含搜索内容、窗口标题、文件路径或新截图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增加快取的視窗縮圖，不包含搜尋內容、視窗標題、檔案路徑或新截圖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュ済みウインドウサムネイルを追加します。検索内容、ウインドウタイトル、ファイルパス、新しいスクリーンショットは含みません。"
          }
        }
      }
    },
    "Adds search text and matching window titles. Excludes file paths and images.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds search text and matching window titles. Excludes file paths and images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增加搜索内容和匹配的窗口标题，不包含文件路径或图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增加搜尋內容和符合的視窗標題，不包含檔案路徑或圖片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索内容と一致したウインドウタイトルを追加します。ファイルパスと画像は含みません。"
          }
        }
      }
    },
    "Could not attach the ZIP automatically. Add it to the email draft from Finder.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not attach the ZIP automatically. Add it to the email draft from Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法自动附加 ZIP，请从 Finder 将其添加到邮件草稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法自動附加 ZIP，請從 Finder 將其加入郵件草稿。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZIP を自動添付できませんでした。Finder からメール下書きに追加してください。"
          }
        }
      }
    },
    "Could not prepare diagnostics: %@": {
      "extractionState": "manual",
      "localizations": {
